# =====================================================================
#  Fill in the 4 required values below, save, then run check.bat.
# =====================================================================

# --- 1. Telegram bot token (REQUIRED) ---------------------------------
# In Telegram, message @BotFather -> /newbot -> copy the token it gives you.
TELEGRAM_BOT_TOKEN=

# --- 2. Your Telegram user id (REQUIRED) ------------------------------
# Message @userinfobot in Telegram; it replies with your numeric "Id".
# Only this account can use the bot - everyone else is ignored.
MEERA_USER_ID=

# --- 3. Supabase database connection string (REQUIRED) ----------------
# In your Supabase project: click "Connect" (top bar) -> "Session pooler"
# -> copy the URI. It looks like:
#   postgresql://postgres.abcdefgh:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Replace [YOUR-PASSWORD] with your database password (Project Settings ->
# Database -> Reset database password if you don't have it).
# NOTE: this is NOT the anon/service_role API key or the https:// project
# URL - the bot talks to the database directly. Tables are created for you.
# Leave empty to use a local SQLite file instead (DB_PATH below).
SUPABASE_DB_URL=

# --- 4. Gemini API key (REQUIRED) ------------------------------------
# The AI that scores notes, transcribes voice notes and writes drafts.
# Get one at https://aistudio.google.com/apikey -> "Create API key".
GEMINI_API_KEY=

# --- Optional ----------------------------------------------------------

# A private Telegram channel you drop notes into. Add the bot as an admin
# of the channel, forward a channel message to @userinfobot to get the id
# (starts with -100...). Leave empty to just DM your notes to the bot.
NOTES_CHANNEL_ID=

# Gemini model used for scoring, drafting, self-check AND transcribing
# voice notes. Must accept audio input and structured output; model list:
# https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash

# Backup models, tried in order when GEMINI_MODEL answers "high demand"
# (Gemini overloads are per model). Leave the line out to use these
# defaults; set it to nothing (GEMINI_FALLBACK_MODELS=) to disable.
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# Local SQLite file - only used when SUPABASE_DB_URL is empty.
DB_PATH=data/skinstinct.db

# IANA timezone the twice-weekly batch runs in.
BATCH_TIMEZONE=Asia/Kolkata

# Batch run time, 24h HH:MM, local to BATCH_TIMEZONE.
BATCH_TIME=08:00

# Connect over IPv4 when a server offers it (fixes ~20s hangs on networks
# with broken IPv6). Set to 0 to use the system default instead.
PREFER_IPV4=1

# --- Vercel webhook deployment (api/webhook.py) only ---
# These are NOT used by the long-polling bot (app/main.py) above and don't
# belong in this .env file for production - set them in Vercel's dashboard
# Environment Variables instead. See README.md's "Vercel webhook" section.
# TELEGRAM_WEBHOOK_SECRET=  (random string, e.g. `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`)
# ALLOWED_CHAT_IDS=          (comma-separated: your user id, your channel id)
# GEMINI_API_KEY=, GEMINI_MODEL=  (same as above)
# SUPABASE_DB_URL=           (same as above - persistent, unlike DB_PATH=/tmp/... on Vercel)
# OUTBOUND_TIMEOUT_SECONDS=12
